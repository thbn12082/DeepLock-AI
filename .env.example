# Chỉ content builder trên máy tính đọc file này. Không copy vào android/ hoặc pack.
# Tùy chọn: trên Windows builder tự đọc key đang active từ DB cục bộ của 9router.
# OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_GENERATOR_MODEL=gpt-5.5
OPENAI_REVIEW_MODEL=gpt-5.5
OPENAI_EDITORIAL_MODEL=gpt-5.5
OPENAI_SERVICE_TIER=priority
NINEROUTER_MODEL_PREFIX=cx/
NINEROUTER_CONCURRENCY=10
OPENAI_GENERATOR_REASONING_EFFORT=medium
OPENAI_MAX_ATOMS_PER_GENERATION_CALL=2
OPENAI_MAX_ATOMS_PER_EDITORIAL_CALL=2
OPENAI_VISION_REASONING_EFFORT=low
OPENAI_REVIEW_REASONING_EFFORT=high
OPENAI_EDITORIAL_REASONING_EFFORT=high
OPENAI_STORE_RESPONSES=false
GENERATOR_PROMPT_VERSION=course-v2
REVIEW_PROMPT_VERSION=reviewer-v2
LEARNER_REWRITE_ENABLED=false
EDITORIAL_PROMPT_VERSION=learner-rewrite-v1
MAX_AI_REPAIR_ROUNDS=2
