{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplock.local/schemas/mind-map.schema.json",
  "title": "MindMap",
  "type": "object",
  "additionalProperties": false,
  "required": ["mind_map_id", "root_node_id", "nodes", "edges"],
  "properties": {
    "mind_map_id": {"type": "string", "minLength": 1},
    "root_node_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "type", "atom_id"],
        "properties": {
          "id": {"type": "string"}, "label": {"type": "string"},
          "type": {"type": "string", "enum": ["COURSE", "MODULE", "TOPIC", "ATOM"]},
          "atom_id": {"type": ["string", "null"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "type"],
        "properties": {
          "from": {"type": "string"}, "to": {"type": "string"},
          "type": {"type": "string", "enum": ["CONTAINS", "PREREQUISITE", "RELATED"]}
        }
      }
    }
  }
}

