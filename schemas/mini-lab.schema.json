{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplock.local/schemas/mini-lab.schema.json",
  "title": "MiniLab",
  "type": "object",
  "additionalProperties": false,
  "required": ["mini_lab_id", "atom_id", "lab_type", "spec", "fallback", "source_ref_ids", "ai_review_status"],
  "properties": {
    "mini_lab_id": {"type": "string", "minLength": 1},
    "atom_id": {"type": "string", "minLength": 1},
    "lab_type": {"type": "string", "enum": ["LR_STEP_1D", "ACTIVATION_CURVE", "CONVOLUTION_2D", "OVERFITTING_CURVE", "CONFUSION_MATRIX"]},
    "spec": {
      "anyOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["initial_weight", "gradient", "learning_rate_min", "learning_rate_max", "learning_rate_default"],
          "properties": {
            "initial_weight": {"type": "number"}, "gradient": {"type": "number"},
            "learning_rate_min": {"type": "number", "minimum": 0.000001, "maximum": 10},
            "learning_rate_max": {"type": "number", "minimum": 0.000001, "maximum": 10},
            "learning_rate_default": {"type": "number", "minimum": 0.000001, "maximum": 10}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["function", "x_min", "x_max", "samples"],
          "properties": {
            "function": {"type": "string", "enum": ["RELU", "SIGMOID", "TANH"]},
            "x_min": {"type": "number", "minimum": -20, "maximum": 0},
            "x_max": {"type": "number", "minimum": 0, "maximum": 20},
            "samples": {"type": "integer", "minimum": 3, "maximum": 256}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["input", "kernel", "stride"],
          "properties": {
            "input": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"type": "number"}}},
            "kernel": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "number"}}},
            "stride": {"type": "integer", "minimum": 1, "maximum": 3}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["train_loss", "validation_loss"],
          "properties": {
            "train_loss": {"type": "array", "minItems": 3, "maxItems": 256, "items": {"type": "number", "minimum": 0}},
            "validation_loss": {"type": "array", "minItems": 3, "maxItems": 256, "items": {"type": "number", "minimum": 0}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["labels", "matrix"],
          "properties": {
            "labels": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"type": "string"}},
            "matrix": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"type": "integer", "minimum": 0}}}
          }
        }
      ]
    },
    "fallback": {
      "type": "object", "additionalProperties": false,
      "required": ["columns", "rows", "takeaways"],
      "properties": {
        "columns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "takeaways": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}}
      }
    },
    "source_ref_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "ai_review_status": {"type": "string", "enum": ["PENDING", "AI_APPROVED", "QUARANTINED"]}
  }
}
