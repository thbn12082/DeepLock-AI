{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplock.local/schemas/module-editorial-rewrite.schema.json",
  "title": "ModuleEditorialRewrite",
  "type": "object",
  "additionalProperties": false,
  "required": ["module_id", "atom_contents"],
  "properties": {
    "module_id": {"type": "string", "minLength": 1},
    "atom_contents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "atom-content.schema.json"}
    }
  }
}
