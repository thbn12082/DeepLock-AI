{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplock.local/schemas/illustration-asset.schema.json",
  "title": "IllustrationAsset",
  "type": "object",
  "additionalProperties": false,
  "required": ["illustration_id", "source_ref_id", "asset_member", "mime_type", "sha256", "byte_size", "width", "height", "page_number", "caption", "alt_text"],
  "properties": {
    "illustration_id": {"type": "string", "minLength": 1},
    "source_ref_id": {"type": "string", "minLength": 1},
    "asset_member": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.(png|webp)$"
    },
    "mime_type": {"type": "string", "enum": ["image/png", "image/webp"]},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "width": {"type": "integer", "minimum": 1, "maximum": 8192},
    "height": {"type": "integer", "minimum": 1, "maximum": 8192},
    "page_number": {"type": "integer", "minimum": 1},
    "caption": {"type": "string", "minLength": 1, "maxLength": 500},
    "alt_text": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}
