{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplock.local/schemas/content-pack.schema.json",
  "title": "ContentPackManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_pack_id",
    "course_id",
    "version",
    "created_at",
    "prompt_version",
    "model",
    "members",
    "ai_review_results_sha256",
    "ai_approved_count",
    "repaired_count",
    "rejected_count",
    "reviewer_model",
    "reviewer_prompt_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "content_pack_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "prompt_version": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "pattern": "^(gpt-[0-9][0-9A-Za-z._-]*|claude-[A-Za-z0-9._\\[\\]-]+)$"
    },
    "members": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "AI_APPROVED",
        "EDITORIAL_REWRITE_APPROVED"
      ]
    },
    "review_scope": {
      "type": "string",
      "enum": [
        "SOURCE_FACTUAL_REVIEW_V1",
        "LEARNER_REWRITE_ONLY_V1"
      ]
    },
    "source_correctness_reviewed": {
      "type": "boolean"
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generator_model_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "ai_review_results_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ai_approved_count": {
      "type": "integer",
      "minimum": 1
    },
    "repaired_count": {
      "type": "integer",
      "minimum": 0
    },
    "rejected_count": {
      "type": "integer",
      "minimum": 0
    },
    "reviewer_model": {
      "type": "string",
      "pattern": "^(gpt-[0-9][0-9A-Za-z._-]*|claude-[A-Za-z0-9._\\[\\]-]+)$"
    },
    "reviewer_prompt_version": {
      "type": "string"
    },
    "reviewer_configured_model": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_model_snapshots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reviewer_prompt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewer_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_schema_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewer_reasoning_effort": {
      "type": "string",
      "minLength": 1
    },
    "editorial_model": {
      "type": "string",
      "pattern": "^(gpt-[0-9][0-9A-Za-z._-]*|claude-[A-Za-z0-9._\\[\\]-]+)$"
    },
    "editorial_configured_model": {
      "type": "string",
      "minLength": 1
    },
    "editorial_model_snapshots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "editorial_prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "editorial_prompt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "editorial_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "editorial_schema_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "editorial_reasoning_effort": {
      "type": "string",
      "minLength": 1
    },
    "store_responses": {
      "type": "boolean",
      "const": false
    },
    "pack_contract_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "editorial_rewrite_coverage": {
      "type": "object",
      "description": "Truthful count of how many atoms a model actually rewrote in this pack. Present when the pack was assembled from cache rather than a complete editorial pass.",
      "additionalProperties": false,
      "properties": {
        "atoms_total": {
          "type": "integer",
          "minimum": 0
        },
        "atoms_rewritten_by_model": {
          "type": "integer",
          "minimum": 0
        },
        "atoms_pass1_only": {
          "type": "integer",
          "minimum": 0
        },
        "verdicts_are_synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "atoms_total",
        "atoms_rewritten_by_model",
        "atoms_pass1_only",
        "verdicts_are_synthetic"
      ]
    }
  }
}
