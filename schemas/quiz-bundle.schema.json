{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplock.local/schemas/quiz-bundle.schema.json",
  "title": "QuizBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions", "insufficient_evidence_items"],
  "properties": {
    "questions": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question_id", "pair_id", "atom_id", "stem", "options", "correct_option_id", "explanation", "difficulty", "bloom_level", "grounding_type", "source_ref_ids"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "pair_id": {"type": "string", "minLength": 1},
          "atom_id": {"type": "string", "minLength": 1},
          "stem": {"type": "string", "minLength": 1},
          "options": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "text", "rationale", "misconception_tag"],
              "properties": {
                "id": {"type": "string", "enum": ["A", "B", "C", "D"]},
                "text": {"type": "string", "minLength": 1},
                "rationale": {"type": "string", "minLength": 1},
                "misconception_tag": {"type": ["string", "null"]}
              }
            }
          },
          "correct_option_id": {"type": "string", "enum": ["A", "B", "C", "D"]},
          "explanation": {"type": "string", "minLength": 1},
          "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
          "bloom_level": {"type": "string", "enum": ["RECALL", "UNDERSTAND", "APPLY", "ANALYZE"]},
          "grounding_type": {"type": "string", "enum": ["SOURCE_GROUNDED", "ENRICHMENT"]},
          "source_ref_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "insufficient_evidence_items": {"type": "array", "items": {"type": "string"}}
  }
}

