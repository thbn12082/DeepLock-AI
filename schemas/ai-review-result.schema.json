{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplock.local/schemas/ai-review-result.schema.json",
  "title": "AIReviewBatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_type", "item_id", "item_revision", "candidate_hash", "source_hash", "verdict", "issue_codes", "evidence_ref_ids", "independent_correct_option_id", "evidence_sufficient", "short_rationale"],
        "properties": {
          "item_type": {"type": "string", "enum": ["LESSON", "QUESTION", "LEARNING_PAIR", "MINI_LAB", "MODULE"]},
          "item_id": {"type": "string", "minLength": 1},
          "item_revision": {"type": "integer", "minimum": 1},
          "candidate_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "verdict": {"type": "string", "enum": ["APPROVE", "REPAIR", "REJECT"]},
          "issue_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_ref_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "independent_correct_option_id": {"type": ["string", "null"], "enum": ["A", "B", "C", "D", null]},
          "evidence_sufficient": {"type": "boolean"},
          "short_rationale": {"type": "string", "maxLength": 500}
        }
      }
    }
  }
}

